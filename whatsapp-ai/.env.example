# Server Configuration
PORT=5000

# Gemini AI Engine Configuration
GEMINI_API_KEY=AQ.Ab8RN6JgNCaYhsV3po7IT5dIHr5swDOR5oobjP9ZtoreMbLi3A
GEMINI_MODEL=gemini-flash-latest

# Google OAuth 2.0 Credentials (Shared for Google Calendar, Google Meet & Gmail)
# Obtain these from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://developers.google.com/oauthplayground
GOOGLE_REFRESH_TOKEN=1//your_google_refresh_token

# Google Calendar & Google Meet Settings
# Leave as "primary" or specify a dedicated calendar ID (e.g., info.groxstudio@gmail.com)
GOOGLE_CALENDAR_ID=primary
